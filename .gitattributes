# Default: normalize text files in repo and keep LF in source/config.
* text=auto

# C/C++ source
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.inl text eol=lf
*.rc text eol=lf

# Build and config
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Python
*.py text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts and solutions
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Binary assets/artifacts
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.flac binary
*.opus binary
*.dll binary
*.exe binary
*.lib binary
*.pdb binary
